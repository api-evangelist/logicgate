                },
                {
                  "disabled": false,
                  "key": "page",
                  "value": "<integer>",
                  "description": "The zero-indexed page number (must not be less than 0, defaults to 0)"
                },
                {
                  "disabled": false,
                  "key": "size",
                  "value": "<integer>",
                  "description": "The size of the page and maximum number of items to be returned (must not be less than 1, defaults to 20)"
